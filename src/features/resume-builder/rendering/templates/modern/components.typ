#import "helpers.typ": *

// -----------------------------------------------------------------------------
// Section
// -----------------------------------------------------------------------------

#let section(
  title,
  body,
) = {
  [
    == #title

    #body
  ]
}

// -----------------------------------------------------------------------------
// Two Column Row
// -----------------------------------------------------------------------------

#let row(
  left,
  right: none,
) = grid(
  columns: (1fr, auto),
  column-gutter: 12pt,

  left,

  if right != none {
    align(right)[#right]
  } else {
    []
  },
)

// -----------------------------------------------------------------------------
// Entry / Timeline
// -----------------------------------------------------------------------------

#let entry(
  title,
  subtitle: none,
  right: none,
  body: none,
) = {
  [
    #row(
      strong(title),
      right,
    )

    #if not-empty(subtitle) {
      emph(subtitle)
    }

    #if body != none {
      v(2pt)
      body
    }

    #v(6pt)
  ]
}

// -----------------------------------------------------------------------------
// Skill Row
// -----------------------------------------------------------------------------

#let skill-row(
  category,
  skills,
) = grid(
  columns: (2.5cm, 1fr),
  column-gutter: 4pt,

  strong(category),

  skills.join(", "),
)

// -----------------------------------------------------------------------------
// Bullet List
// -----------------------------------------------------------------------------

#let bullet-list(
  items,
) = {
  for item in items {
    [
      #bullet(item)
      #linebreak()
    ]
  }
}

// -----------------------------------------------------------------------------
// Contact Row
// -----------------------------------------------------------------------------

#let contact-row(
  items,
) = join(  items, separator: " | ",  )

// -----------------------------------------------------------------------------
// Link Row
// -----------------------------------------------------------------------------

#let link-row(
  links,
) = join(
  links,
  separator: " | ",
)
